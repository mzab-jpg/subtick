# ============================================================
# Tangent — Environment Variables
# Copy this file to .env.local and fill in values as needed.
# .env.local is gitignored and must never be committed.
# ============================================================

# --- Firebase Emulator ---
# Set to "true" to connect the app to local Firebase Emulators instead of production.
# Requires `firebase emulators:start` to be running in the firebase/ directory.
# Only takes effect when the app is built in __DEV__ mode (Expo development build).
# Leave blank or omit entirely for production builds.
EXPO_PUBLIC_USE_EMULATORS=false

# --- Firebase Web Config (optional override) ---
# By default, the Firebase config is read directly from src/services/firebase.ts.
# If you want to override individual values (e.g. for a staging project),
# set the variables below. Unset variables fall back to the hardcoded defaults.
#
# Note: Firebase web SDK config values (apiKey, projectId, etc.) are public
# identifiers — they are NOT secrets. Security is enforced by Firestore rules,
# not by keeping these keys private.
#
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=